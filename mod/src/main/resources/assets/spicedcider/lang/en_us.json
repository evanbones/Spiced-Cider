  "option.spicedcider.unifiedPetArmor.tooltip": "Horse armor works like wolf armor: it tanks the hit, loses durability, and is repaired by right-clicking the pet with the armor's material. Applies to horses and, with wolvesWearAnyArmor, to wolves. Requires a restart to take effect.",
  "option.spicedcider.unmineableBlockSparks": "Unmineable Block Sparks",
  "option.spicedcider.unmineableBlockSparks.tooltip": "Spawns sparks, plays hit sounds, and displays a warning message when attempting to mine a block that requires a stronger tool.",
  "option.spicedcider.vistaMirrorIdleUpdateFps": "Mirror Idle Update Rate",
  "option.spicedcider.vistaMirrorIdleUpdateFps.tooltip": "Reflection update rate used while the viewer's eye is stationary. Set equal to update rate to disable the idle slowdown.",
  "option.spicedcider.vistaMirrorMinUpdateFps": "Mirror Minimum Update Rate",
  "option.spicedcider.vistaMirrorMinUpdateFps.tooltip": "The floor that the mirror update rate will never drop below. Values above the base update rate are ignored.",
  "option.spicedcider.vistaMirrorPerfFixes": "Mirror Performance Fixes",
  "option.spicedcider.vistaMirrorPerfFixes.tooltip": "Applies performance fixes to Vista's mirror/TV reflection rendering (better culling, better shared-states, re-render throttling). Requires Vista (obviously).",
  "option.spicedcider.vistaMirrorReflectionDistance": "Mirror Reflection Distance",
  "option.spicedcider.vistaMirrorReflectionDistance.tooltip": "Max distance in blocks that terrain and entities render to inside a mirror reflection. Only lowers Vista's own television.render_distance (which affects TVs and mirrors). Does not affect TV live feeds.",
  "option.spicedcider.vistaMirrorThrottleBudgetMs": "Mirror Frame Budget (ms)",
  "option.spicedcider.vistaMirrorThrottleBudgetMs.tooltip": "Max milliseconds per frame that all mirror reflection renders may take before being throttled.",
  "option.spicedcider.vistaMirrorUpdateFps": "Mirror Update Rate",
  "option.spicedcider.vistaMirrorUpdateFps.tooltip": "Regular reflection render rate per mirror, in updates per second, when the frame budget is not under pressure. Values at or above 20 mean effectively every frame.",
  "option.spicedcider.voidWater": "Void Water",
  "option.spicedcider.voidWater.tooltip": "Fluids at the bottom of the world spill into the void as fading trails you can swim in. Takes effect when a world is next loaded.",
  "option.spicedcider.voidWaterExcludedDimensions": "Void Water Excluded Dimensions",
  "option.spicedcider.voidWaterExcludedDimensions.tooltip": "Dimension ids where fluids never spill into the void. The End is excluded by default because its floor is a sea of Dimensional Tears.",
  "option.spicedcider.voidWaterTrailDecay": "Void Water Trail Fade",
  "option.spicedcider.voidWaterTrailDecay.tooltip": "How quickly void fluid trails fade out. Higher values fade faster.",
  "option.spicedcider.voidWaterTrailLength": "Void Water Trail Length",
  "option.spicedcider.voidWaterTrailLength.tooltip": "How many blocks fluid trails extend below the bottom of the world.",
  "option.spicedcider.voxyCaveFogDensity": "Cave Fog Density",
  "option.spicedcider.voxyCaveFogDensity.tooltip": "How much closer the fog gets when you are underground, away from the sky. 0% disables cave fog.",
  "option.spicedcider.voxyFadeIn": "LoD Fade In",
  "option.spicedcider.voxyFadeIn.tooltip": "Fades newly loaded or generated Voxy LoD terrain in from the fog colour, like Chunks Fade In does for normal chunks.",
  "option.spicedcider.voxyFogEnd": "Fog End",
  "option.spicedcider.voxyFogEnd.tooltip": "Distance where the fog becomes fully opaque, as a percentage of the Voxy LoD render distance (or the normal render distance if Voxy is not rendering).",
  "option.spicedcider.voxyFogOverride": "Custom Fog",
  "option.spicedcider.voxyFogOverride.tooltip": "Replaces the terrain fog with configurable start and end distances that cover Voxy's LoD terrain, plus weather and cave fog. Disable to use Roxy's own fog.",
  "option.spicedcider.voxyFogStart": "Fog Start",
  "option.spicedcider.voxyFogStart.tooltip": "Distance where the fog begins, as a percentage of the Voxy LoD render distance (or the normal render distance if Voxy is not rendering).",
  "option.spicedcider.voxyWeatherFogDensity": "Weather Fog Density",
  "option.spicedcider.voxyWeatherFogDensity.tooltip": "How much closer the fog gets during rain, snow and thunderstorms. Thunderstorms count for twice as much as rain. 0% disables weather fog.",
  "option.spicedcider.voxyWorldGenPauseFix": "Voxy WorldGen Pause Fix",
  "option.spicedcider.voxyWorldGenPauseFix.tooltip": "Stops Voxy World Gen V2 from discarding the client's pause callback when a world loads, so chunk generation actually halts while the pause menu is open instead of running until the heap is exhausted. Requires Voxy World Gen V2.",
  "option.spicedcider.voxyWorldGenPersistStats": "Voxy WorldGen Persistent Stats",
  "option.spicedcider.voxyWorldGenPersistStats.tooltip": "Remembers the received-chunk total in Voxy World Gen V2's debug overlay per world or server, instead of resetting it to zero every time you reconnect. Requires Voxy World Gen V2.",
  "option.spicedcider.voxyWorldGenSafeCatchup": "Voxy WorldGen Safe Catch-Up",
  "option.spicedcider.voxyWorldGenSafeCatchup.tooltip": "Replaces Voxy World Gen V2's LOD catch-up pass with one that never blocks the server thread on a chunk request. Fixes the client hanging forever on Save & Quit to Title, especially alongside C2ME. Requires Voxy World Gen V2.",
  "option.spicedcider.voxyWorldGenSyncUnloadedChunks": "Voxy WorldGen Sync Unloaded Chunks",
  "option.spicedcider.voxyWorldGenSyncUnloadedChunks.tooltip": "Lets the LOD catch-up pass pull already-generated chunks back off disk so distant terrain still syncs to players who join after generation finished. Requires Voxy World Gen V2 and Safe Catch-Up.",
  "option.spicedcider.windowTitleFormat": "Window Title Format",
  "option.spicedcider.windowTitleFormat.tooltip": "Format string for the OS window title. %v will be replaced with the current Minecraft version.",
  "option.spicedcider.wolvesWearAnyArmor": "Wolves Wear Any Armor",
  "option.spicedcider.wolvesWearAnyArmor.tooltip": "Tamed wolves can be equipped with horse/animal armor as body armor.",
