{
  "multipart": [
    {
      "when": {
        "axis": "y"
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_core"
      }
    },
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_core",
        "x": 90
      }
    },
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_core",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "OR": [
          {
            "up": "true"
          },
          {
            "axis": "y",
            "down": "false"
          },
          {
            "axis": "y",
            "north": "false",
            "south": "false",
            "east": "false",
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_arm"
      }
    },
    {
      "when": {
        "OR": [
          {
            "down": "true"
          },
          {
            "axis": "y",
            "up": "false"
          },
          {
            "axis": "y",
            "north": "false",
            "south": "false",
            "east": "false",
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_arm",
        "x": 180
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "true"
          },
          {
            "axis": "z",
            "south": "false"
          },
          {
            "axis": "z",
            "up": "false",
            "down": "false",
            "east": "false",
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_arm",
        "x": 90
      }
    },
    {
      "when": {
        "OR": [
          {
            "south": "true"
          },
          {
            "axis": "z",
            "north": "false"
          },
          {
            "axis": "z",
            "up": "false",
            "down": "false",
            "east": "false",
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_arm",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "OR": [
          {
            "east": "true"
          },
          {
            "axis": "x",
            "west": "false"
          },
          {
            "axis": "x",
            "up": "false",
            "down": "false",
            "north": "false",
            "south": "false"
          }
        ]
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_arm",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "OR": [
          {
            "west": "true"
          },
          {
            "axis": "x",
            "east": "false"
          },
          {
            "axis": "x",
            "up": "false",
            "down": "false",
            "north": "false",
            "south": "false"
          }
        ]
      },
      "apply": {
        "model": "spicedcider:block/stripped_pear_log_arm",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "leafy": "true"
      },
      "apply": {
        "model": "spicedcider:block/pear_leaves"
      }
    }
  ]
}
