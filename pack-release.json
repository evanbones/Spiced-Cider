{
  "remove": [
    "mods/packdev_toolkit-*",
    "config/packdev_toolkit.json"
  ],
  "json": {
    "config/remi/remi.json": {
      "emiOnlyInRecipeBook": true
    },
    "config/reliable_remover.json": {
      "enableEmiRemoval": false,
      "enableJeiRemoval": false,
      "enableRrvRemoval": false
    },
    "config/reliable_recipes.json": {
      "devMode": false
    },
    "config/reliable_advancements.json": {
      "enableEditMode": false,
      "showEditModeButton": false
    }
  },
  "zip": [
    "resourcepacks/spicedcider_resources",
    "config/openloader/packs/*"
  ],
  "replace": {
    "config/resourcepackoverrides.json": [
      [
        "\"file/spicedcider_resources\"",
        "\"file/spicedcider_resources.zip\""
      ]
    ],
    "config/yosbr/options.txt": [
      [
        "\"file/spicedcider_resources\"",
        "\"file/spicedcider_resources.zip\""
      ]
    ]
  },
  "client_only": [
    "resourcepacks/*",
    "shaderpacks/*",
    "mods/continuity-*"
  ]
}
