{
  "activation_condition": "config('sunbathing:enabled') && g.skyType()==1 && g.rain()<0.2",
  "post_chain": "sunbathing:godrays",
  "use_depth_buffer": true,
  "priority": 0.0,
  "expression_uniforms": {
    "SunRayIntensity": "config('sunbathing:sun_intensity') * (1 - smoothstep(0, 0.2, g.rain()))",
    "MoonRayIntensity": "config('sunbathing:moon_intensity') * (1 - smoothstep(0, 0.2, g.rain()))",
    "RayQuality": "config('sunbathing:quality')",
    "RayDensity": "config('sunbathing:density')",
    "RayDecay": "config('sunbathing:decay')"
  }
}
