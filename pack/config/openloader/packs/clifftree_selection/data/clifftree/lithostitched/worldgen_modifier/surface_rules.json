{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "add_stone_depth": true,
            "offset": -10,
            "surface_depth_multiplier": 0,
            "type": "minecraft:water"
          },
          "then_run": {
            "type": "minecraft:condition",
            "if_true": {
              "add_surface_depth": false,
              "offset": 2,
              "secondary_depth_range": 3,
              "surface_type": "floor",
              "type": "minecraft:stone_depth"
            },
            "then_run": {
              "type": "minecraft:condition",
              "if_true": {
                "biome_is": [
                  "clifftree:oasis"
                ],
                "type": "minecraft:biome"
              },
              "then_run": {
                "type": "minecraft:condition",
                "if_true": {
                  "invert": {
                    "add_stone_depth": true,
                    "offset": -4,
                    "surface_depth_multiplier": 0,
                    "type": "minecraft:water"
                  },
                  "type": "minecraft:not"
                },
                "then_run": {
                  "result_state": {
                    "Name": "light_gray_terracotta",
                    "Properties": {}
                  },
                  "type": "block"
                }
              }
            }
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "add_surface_depth": false,
            "offset": 8,
            "secondary_depth_range": 0,
            "surface_type": "floor",
            "type": "minecraft:stone_depth"
          },
          "then_run": {
            "type": "minecraft:condition",
            "if_true": {
              "add_stone_depth": true,
              "offset": -5,
              "surface_depth_multiplier": 0,
              "type": "minecraft:water"
            },
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "biome_is": [
                      "clifftree:oasis"
                    ],
                    "type": "minecraft:biome"
                  },
                  "then_run": {
                    "type": "lithostitched:bandlands",
                    "options": "clifftree:alternate"
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "biome_is": [
                      "minecraft:savanna_plateau"
                    ],
                    "type": "minecraft:biome"
                  },
                  "then_run": {
                    "type": "lithostitched:bandlands",
                    "options": "clifftree:savanna"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
